{
  "name": "house-finder",
  "version": "1.8.0",
  "private": true,
  "description": "Multi-channel rental listing monitor with AI scoring and a local web dashboard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "monitor": "tsx src/index.ts",
    "test:telegram": "tsx scripts/test-telegram.ts",
    "try:score": "tsx scripts/try-score.ts",
    "try:health": "tsx scripts/try-health.ts",
    "try:email": "tsx scripts/try-email.ts",
    "try:source": "tsx scripts/try-source.ts",
    "try:update": "tsx scripts/try-update.ts",
    "try:cities": "tsx scripts/try-cities.ts",
    "debug:page": "tsx scripts/debug-page.ts",
    "debug:fb": "tsx scripts/debug-fb.ts",
    "probe:next": "tsx scripts/probe-next.ts",
    "fix:thumbs": "tsx scripts/repair-thumbs.ts",
    "docs:shots": "tsx scripts/shoot-docs.ts",
    "fb:login": "tsx scripts/fb-login.ts",
    "fb:from-brave": "tsx scripts/fb-from-brave.ts",
    "fb:run": "tsx scripts/fb-run.ts",
    "serve": "tsx scripts/serve.ts",
    "ui:install": "npm --prefix ui install",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "start": "npm run ui:build && npm run serve",
    "build:bundle": "node scripts/build-bundle.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "imapflow": "^1.7.8",
    "mailparser": "^3.12.4",
    "openai": "^6.45.0",
    "playwright": "^1.49.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^4.17.25",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
