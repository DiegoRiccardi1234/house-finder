# Copia in .env e riempi. NON committare .env.

# --- Email IMAP (canale principale: ricerche salvate dei portali) ---
# Virgilio: host in.virgilio.it, porta 993, password normale dell'account.
IMAP_HOST=in.virgilio.it
IMAP_PORT=993
IMAP_USER=tuonome@virgilio.it
IMAP_PASS=la-tua-password
# IMAP_FOLDER=INBOX          # o una cartella/etichetta dedicata

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
# Selezione modelli HEALTH-AWARE: prima di usarli l'app interroga /endpoints (gratis, no
# quota) e usa il modello sano migliore da un pool (src/config/models.ts). Gli override qui
# sotto entrano in testa al pool ma restano soggetti al filtro salute: un modello morto
# (es. openai/gpt-oss-120b:free = 0 endpoint) viene comunque scartato in automatico.
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free       # preferenza reasoning
# AI_MODEL_FALLBACK=...                                  # secondo reasoning (opzionale)
# VISION_MODEL=google/gemma-4-26b-a4b-it:free            # preferenza vision foto
# AI_HEALTH_MIN_UPTIME=90     # % uptime_last_5m minimo per considerare sano un modello
# AI_HEALTH_BAND=2            # ampiezza fascia uptime (%): a parità di fascia vince la preferenza-pool
# AI_HEALTH_TTL_MS=300000     # cache salute per-slug in ms (default 5 min)

# --- Server / UI ---
# PORT=3000                  # porta del server Express (UI + API). Dev UI Vite = :5173.
# LISTINGS_PATH=state/listings.json   # archivio annunci (contenuto + voto + stato)

# --- Output ---
# Default: Web UI (npm start / npm run serve). Telegram è OPZIONALE e OFF di default.
NOTIFY_TELEGRAM=0            # =1 per mandare i nuovi anche su Telegram (serve token+chat id sotto)
# TELEGRAM_BOT_TOKEN=123456:ABC-tuo-token-da-BotFather
# TELEGRAM_CHAT_ID=123456789

# --- Opzionali run ---
# DRY_RUN=1          # non notifica, solo log
# MIN_SCORE=60       # non notifica case sotto questo voto AI (default 0 = tutte)
# MAX_NOTIFY=25      # tetto notifiche per run
# ENABLE_SCRAPERS=1  # nel wrapper CLI `npm run monitor`: aggiunge Subito+Immobiliare headed

# --- Scraper browser (solo PC: Subito / Immobiliare / Facebook) ---
# HEADLESS=1         # forza headless (verrà BLOCCATO dai portali: solo debug)
# BROWSER_CHANNEL=chrome     # usa Chrome vero (consigliato vs DataDome)
# PROXY_URL=http://user:pass@host:port

# --- Facebook (gruppi + Marketplace) ---
# Sessione una-tantum: npm run fb:from-brave (riusa il profilo Brave dove sei già loggato,
# a Brave CHIUSO) oppure npm run fb:login (apre un browser e logghi a mano).
# Sessione in state/fb-state.json (gitignorato, NON committare). Poi: npm run fb:run
# FB_STATE_PATH=state/fb-state.json
# FB_MAX_SCROLL=4                          # scroll per pagina (più = più post, più lento)
